{
  "name": "stage-light-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "npm run verify:power && npm run verify:render",
    "verify:power": "esbuild scripts/verify-power.ts --bundle --format=cjs --platform=node --outfile=node_modules/.verify-power.cjs --log-level=error && node node_modules/.verify-power.cjs",
    "verify:render": "esbuild scripts/verify-render.tsx --bundle --format=cjs --platform=node --outfile=node_modules/.verify-render.cjs --log-level=error && node node_modules/.verify-render.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^5.16.7",
    "@vitejs/plugin-react": "^4.3.1",
    "antd": "^5.20.6",
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.168.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
